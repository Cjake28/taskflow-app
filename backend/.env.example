NODE_ENV=development
PORT=4000
LOG_LEVEL=info
TRUST_PROXY=loopback

FRONTEND_URL=http://localhost:5173

DATABASE_URL=postgresql://taskflow:taskflow@localhost:5432/taskflow
DATABASE_URL_TEST=postgresql://taskflow:taskflow@localhost:5432/taskflow_test
REDIS_URL=redis://:taskflow@localhost:6379/0

# Replace with a long random value, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-random-string-of-at-least-32-chars
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
REFRESH_TOKEN_REMEMBER_TTL_DAYS=30
COOKIE_SECURE=false

HIBP_ENABLED=true

# Multiplies rate-limit budgets (tests use 1000). Keep 1 in development and production.
RATE_LIMIT_SCALE=1
PASSWORD_RESET_TTL_MINUTES=30

# Swagger UI at /api/docs (OpenAPI JSON at /api/docs/openapi.json)
API_DOCS_ENABLED=true

# Background jobs: run the BullMQ workers inside the API process (set false and run `npm run worker` separately)
RUN_WORKER_IN_API=true

# Email (defaults point at Mailpit from docker compose; inbox at http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="TaskFlow <no-reply@taskflow.local>"

# Storage: local | s3 | r2 (images are always private and served through the API)
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./storage

# STORAGE_DRIVER=s3 — AWS S3 or an S3-compatible service.
# Local testing: `docker compose --profile s3 up -d` starts SeaweedFS with these values:
#   S3_BUCKET=taskflow  S3_REGION=us-east-1  S3_ENDPOINT=http://localhost:8333
#   S3_FORCE_PATH_STYLE=true  S3_ACCESS_KEY_ID=taskflow  S3_SECRET_ACCESS_KEY=taskflow-secret
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# STORAGE_DRIVER=r2 — Cloudflare R2 (endpoint and region are derived from the account id)
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Images
UPLOAD_MAX_FILE_MB=5
USER_STORAGE_QUOTA_MB=100
# Removed images can be restored for this many days, then a daily job deletes them (0 = immediately)
IMAGE_RETENTION_DAYS=7
# Stored objects without a database row are removed after this many hours
ORPHAN_GRACE_HOURS=24

# OAuth (optional) — a provider is enabled only when its client id AND secret are set.
# Callback URLs to register with the provider: <OAUTH_REDIRECT_BASE_URL>/google/callback and /github/callback
# Defaults to <FRONTEND_URL>/api/v1/auth/oauth (the Vite dev server proxies /api to the backend).
OAUTH_REDIRECT_BASE_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
