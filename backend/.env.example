NODE_ENV=development
PORT=4000
LOG_LEVEL=info
TRUST_PROXY=loopback

FRONTEND_URL=http://localhost:5173

DATABASE_URL=postgresql://taskflow:taskflow@localhost:5432/taskflow
DATABASE_URL_TEST=postgresql://taskflow:taskflow@localhost:5432/taskflow_test
REDIS_URL=redis://:taskflow@localhost:6379/0

# Replace with a long random value, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-random-string-of-at-least-32-chars
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
REFRESH_TOKEN_REMEMBER_TTL_DAYS=30
COOKIE_SECURE=false

HIBP_ENABLED=true

# Multiplies rate-limit budgets (tests use 1000). Keep 1 in development and production.
RATE_LIMIT_SCALE=1
PASSWORD_RESET_TTL_MINUTES=30

# Background jobs: run the BullMQ workers inside the API process (set false and run `npm run worker` separately)
RUN_WORKER_IN_API=true

# Email (defaults point at Mailpit from docker compose; inbox at http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="TaskFlow <no-reply@taskflow.local>"
