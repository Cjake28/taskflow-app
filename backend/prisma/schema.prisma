generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  COMPLETED

  @@map("task_status")
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH

  @@map("task_priority")
}

enum TokenType {
  PASSWORD_RESET
  EMAIL_VERIFICATION

  @@map("token_type")
}

enum ActivityAction {
  CREATED
  UPDATED
  STATUS_CHANGED
  DELETED
  IMAGE_ADDED
  IMAGE_REMOVED

  @@map("activity_action")
}

enum OAuthProvider {
  GOOGLE
  GITHUB

  @@map("oauth_provider")
}

enum NotificationType {
  TASK_REMINDER
  DUE_SOON
  DAILY_DIGEST
  NEW_SIGN_IN

  @@map("notification_type")
}

enum ImageKind {
  AVATAR
  TASK

  @@map("image_kind")
}

model User {
  id              String    @id @default(uuid(7)) @db.Uuid
  firstName       String    @map("first_name") @db.VarChar(50)
  lastName        String    @map("last_name") @db.VarChar(50)
  username        String    @unique @db.VarChar(30)
  email           String    @unique @db.VarChar(255)
  passwordHash    String?   @map("password_hash")
  avatarImageId   String?   @unique @map("avatar_image_id") @db.Uuid
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  avatarImage            Image?                  @relation("UserAvatar", fields: [avatarImageId], references: [id], onDelete: SetNull)
  images                 Image[]                 @relation("UserImages")
  tasks                  Task[]
  sessions               Session[]
  tokens                 VerificationToken[]
  activities             TaskActivity[]
  oauthAccounts          OAuthAccount[]
  reminders              TaskReminder[]
  notifications          Notification[]
  notificationPreference NotificationPreference?
  knownDevices           KnownDevice[]

  @@map("users")
}

model Session {
  id                String    @id @default(uuid(7)) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  refreshTokenHash  String    @map("refresh_token_hash") @db.Char(64)
  previousTokenHash String?   @map("previous_token_hash") @db.Char(64)
  rotatedAt         DateTime? @map("rotated_at") @db.Timestamptz(3)
  persistent        Boolean   @default(false)
  userAgent         String?   @map("user_agent") @db.VarChar(512)
  ipAddress         String?   @map("ip_address") @db.Inet
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(3)
  lastUsedAt        DateTime  @default(now()) @map("last_used_at") @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  type      TokenType
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("verification_tokens")
}

model OAuthAccount {
  id                String        @id @default(uuid(7)) @db.Uuid
  userId            String        @map("user_id") @db.Uuid
  provider          OAuthProvider
  providerAccountId String        @map("provider_account_id") @db.VarChar(255)
  email             String?       @db.VarChar(255)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@unique([userId, provider])
  @@map("oauth_accounts")
}

model Task {
  id          String       @id @default(uuid(7)) @db.Uuid
  userId      String       @map("user_id") @db.Uuid
  title       String       @db.VarChar(200)
  description String?      @db.Text
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  dueDate     DateTime?    @map("due_date") @db.Timestamptz(3)
  hasDueTime  Boolean      @default(false) @map("has_due_time")
  completedAt DateTime?    @map("completed_at") @db.Timestamptz(3)
  position    Float        @default(0)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  activities    TaskActivity[]
  images        Image[]
  reminders     TaskReminder[]
  notifications Notification[]

  @@index([userId, status, position])
  @@index([userId, dueDate])
  @@index([userId, createdAt])
  @@map("tasks")
}

model Image {
  id           String    @id @default(uuid(7)) @db.Uuid
  ownerId      String    @map("owner_id") @db.Uuid
  taskId       String?   @map("task_id") @db.Uuid
  kind         ImageKind
  storageKey   String    @unique @map("storage_key") @db.VarChar(255)
  thumbKey     String?   @unique @map("thumb_key") @db.VarChar(255)
  originalName String?   @map("original_name") @db.VarChar(255)
  sizeBytes    Int       @map("size_bytes")
  width        Int
  height       Int
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  owner    User  @relation("UserImages", fields: [ownerId], references: [id], onDelete: Cascade)
  task     Task? @relation(fields: [taskId], references: [id], onDelete: SetNull)
  avatarOf User? @relation("UserAvatar")

  @@index([ownerId, deletedAt])
  @@index([taskId, createdAt])
  @@index([deletedAt])
  @@map("images")
}

model TaskActivity {
  id        String         @id @default(uuid(7)) @db.Uuid
  userId    String         @map("user_id") @db.Uuid
  taskId    String?        @map("task_id") @db.Uuid
  action    ActivityAction
  taskTitle String         @map("task_title") @db.VarChar(200)
  changes   Json?
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  task Task? @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([taskId, createdAt])
  @@map("task_activities")
}

/// A reminder the user set on a task. Relative reminders count back from the due time and
/// follow it when the due date changes; absolute ones fire at a fixed moment.
model TaskReminder {
  id            String    @id @default(uuid(7)) @db.Uuid
  taskId        String    @map("task_id") @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  /// Minutes before the due time; null for a reminder at a fixed moment.
  offsetMinutes Int?      @map("offset_minutes")
  /// When it fires. Null while a relative reminder's task has no due date.
  remindAt      DateTime? @map("remind_at") @db.Timestamptz(3)
  message       String?   @db.VarChar(500)
  sentAt        DateTime? @map("sent_at") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([sentAt, remindAt])
  @@map("task_reminders")
}

/// Something that happened for a user: shown in the in-app feed and, by preference, emailed.
model Notification {
  id        String           @id @default(uuid(7)) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  type      NotificationType
  title     String           @db.VarChar(255)
  body      String?          @db.Text
  taskId    String?          @map("task_id") @db.Uuid
  data      Json?
  /// False when in-app notifications of this type are off (the row still de-duplicates).
  inApp     Boolean          @default(true) @map("in_app")
  /// Makes scheduled notifications idempotent, e.g. `due-soon:<taskId>:<dueAt>`.
  dedupeKey String?          @map("dedupe_key") @db.VarChar(160)
  readAt    DateTime?        @map("read_at") @db.Timestamptz(3)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  task Task? @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@unique([userId, dedupeKey])
  @@index([userId, inApp, id])
  @@map("notifications")
}

/// Per-user notification settings. A missing row means the defaults below.
model NotificationPreference {
  userId             String   @id @map("user_id") @db.Uuid
  timezone           String   @default("UTC") @db.VarChar(64)
  timezoneAuto       Boolean  @default(true) @map("timezone_auto")
  taskReminderInApp  Boolean  @default(true) @map("task_reminder_in_app")
  taskReminderEmail  Boolean  @default(true) @map("task_reminder_email")
  dueSoonInApp       Boolean  @default(true) @map("due_soon_in_app")
  dueSoonEmail       Boolean  @default(true) @map("due_soon_email")
  dueSoonLeadMinutes Int      @default(60) @map("due_soon_lead_minutes")
  dailyDigestInApp   Boolean  @default(true) @map("daily_digest_in_app")
  dailyDigestEmail   Boolean  @default(true) @map("daily_digest_email")
  dailyDigestTime    String   @default("08:00") @map("daily_digest_time") @db.Char(5)
  /// The user's local date (yyyy-MM-dd) of the last daily summary, so it goes out once a day.
  lastDigestOn       String?  @map("last_digest_on") @db.Char(10)
  newSignInInApp     Boolean  @default(true) @map("new_sign_in_in_app")
  newSignInEmail     Boolean  @default(true) @map("new_sign_in_email")
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

/// Browsers a user has signed in from, recognised by a long-lived random cookie (stored hashed).
model KnownDevice {
  id          String   @id @default(uuid(7)) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  tokenHash   String   @map("token_hash") @db.Char(64)
  label       String   @db.VarChar(120)
  lastIp      String?  @map("last_ip") @db.Inet
  firstSeenAt DateTime @default(now()) @map("first_seen_at") @db.Timestamptz(3)
  lastSeenAt  DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tokenHash])
  @@map("known_devices")
}
