{
  "name": "@taskflow/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "prisma:generate": "prisma generate",
    "predev": "prisma generate",
    "pretest": "prisma generate",
    "pretypecheck": "prisma generate",
    "worker": "tsx src/worker.ts",
    "prestart": "prisma generate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1144.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@taskflow/shared": "*",
    "arctic": "^3.7.0",
    "argon2": "^0.45.1",
    "bowser": "^2.14.1",
    "bullmq": "^6.3.10",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.13",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "rate-limiter-flexible": "^11.2.1",
    "sharp": "^0.35.5",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.19.0",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "pino-pretty": "^13.1.3",
    "prisma": "7.10.0",
    "supertest": "^7.3.0",
    "tsx": "^4.23.15"
  }
}
