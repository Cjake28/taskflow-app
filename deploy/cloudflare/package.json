{
  "name": "taskflow-cloudflare",
  "private": true,
  "description": "Deploys TaskFlow to Cloudflare: the web app as Worker static assets and the API as a Container",
  "type": "module",
  "scripts": {
    "build:web": "npm run build -w @taskflow/frontend --prefix ../..",
    "deploy": "npm run build:web && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "tail": "wrangler tail"
  },
  "dependencies": {
    "@cloudflare/containers": "^0.3.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261001.1",
    "typescript": "6.0.3",
    "wrangler": "^4.145.0"
  }
}
